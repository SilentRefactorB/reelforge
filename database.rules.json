{
  "rules": {
    "kpis":       { ".read": true, ".write": false },
    "monthly":    { ".read": true, ".write": false },
    "catalog":    { ".read": true, ".write": false },
    "breakdowns": { ".read": true, ".write": false },
    "presence": {
